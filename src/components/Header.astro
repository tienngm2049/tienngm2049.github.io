---
import { SITE, NAV } from '../config';
import Icon from './Icon.astro';
const path = Astro.url.pathname;
// Home ('/') chỉ sáng khi đúng trang chủ; các mục khác sáng cả ở trang con (vd /blog/abc/ -> Writing)
---
<header class="site-header">
  <div class="container wide header-inner">
    <a href="/" class="brand"><span class="brand-mark" aria-hidden="true"></span><span class="brand-name">{SITE.name}</span></a>
    <nav>
      {NAV.map((item) => (
        <a href={item.href} aria-current={(item.href === '/' ? path === '/' : path.startsWith(item.href)) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
      <button type="button" class="icon-btn" data-theme-toggle aria-label="Toggle dark mode" title="Toggle dark mode">
        <Icon name="theme" size={18} />
      </button>
    </nav>
  </div>
</header>
